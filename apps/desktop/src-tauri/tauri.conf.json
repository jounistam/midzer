{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "midzer",
  "version": "0.1.0",
  "identifier": "app.midzer.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../.. fetch:sounds && pnpm --filter @midzer/web dev",
    "beforeBuildCommand": "pnpm --dir ../.. fetch:sounds && pnpm --filter @midzer/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "midzer",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#05040a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "An interactive backing band",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
